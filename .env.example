# Copy to .env or set process environment variables (environment takes priority).
HOST=127.0.0.1
PORT=3210
PUBLIC_ORIGIN=http://127.0.0.1:3210
# Temporary public HTTP testing only: session cookies travel without encryption.
ALLOW_INSECURE_HTTP_TEST=0
# Optional separate direct listener; must match PUBLIC_ORIGIN's port. Keep blank for HTTPS deployments.
PUBLIC_HTTP_TEST_PORT=
ENABLE_DEMO=1
# Leave ranked queue disabled until cloud game-server acceptance tests pass.
ENABLE_RANKED=0
# Comma-separated verified SteamID64 values. No automatic first-user administrator.
ADMIN_STEAM_IDS=
# New matches use two legs; existing matches retain their saved format.
MATCH_FORMAT=two-leg-v1
# Enable only behind a trusted Caddy instance on this machine; keep HOST loopback.
TRUST_LOCAL_PROXY=0
# Optional Steam profile API key. Login itself uses OpenID and needs no key.
STEAM_WEB_API_KEY=
# Optional HTTP proxy for Steam verification/profile requests only.
# Local SDKDNS example: http://127.0.0.1:7897. Leave empty on a direct-access cloud host.
STEAM_HTTP_PROXY=
# Future trusted server integration; set a random value of at least 32 characters.
BRIDGE_TOKEN=
